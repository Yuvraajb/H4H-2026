# LLM: groq (default), openai, anthropic, or gemini
LLM_PROVIDER=groq

# Set the one matching LLM_PROVIDER
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# ElevenLabs for TTS (optional; app still works without it, but no voice)
ELEVENLABS_API_KEY=...

# Step images from the web (right-panel WikiHow-style steps). Create a Programmable Search Engine with Image search enabled.
GOOGLE_CSE_ID=...
GOOGLE_CSE_API_KEY=...
# Or use GOOGLE_API_KEY if you prefer (same key as some other Google APIs).
